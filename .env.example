# Environment
APP_ENV=local
APP_URL=http://localhost:8080
WORDPRESS_URL=http://localhost:8080
WORDPRESS_DEBUG=false

# Database (Docker locally; replace values for deployment)
DB_HOST=db
DB_PORT=3306
DB_NAME=againbuy
DB_USER=againbuy
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# WordPress secrets — unique values per environment
WORDPRESS_AUTH_KEY=change_me
WORDPRESS_SECURE_AUTH_KEY=change_me
WORDPRESS_LOGGED_IN_KEY=change_me
WORDPRESS_NONCE_KEY=change_me
WORDPRESS_AUTH_SALT=change_me
WORDPRESS_SECURE_AUTH_SALT=change_me
WORDPRESS_LOGGED_IN_SALT=change_me
WORDPRESS_NONCE_SALT=change_me

# Initial local administrator only
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=admin@example.com
ANALYTICS_USER=analytics
ANALYTICS_PASSWORD=change_me
ANALYTICS_EMAIL=analytics@example.com

# Neviri S3-compatible Object Storage
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true


# Redis — local Docker or the same backend VM initially
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email — Mailpit locally; production SMTP later
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS=orders@againbuy.in
MAIL_FROM_NAME=AgainBuy

# Razorpay — test keys first, production keys only in deployment secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Currency and geolocation
STORE_BASE_CURRENCY=INR
INDIA_CURRENCY=INR
INTERNATIONAL_CURRENCY=USD
INDIA_DELIVERY_CHARGE_INR=120
INTERNATIONAL_DELIVERY_CHARGE_USD=
DEFAULT_COUNTRY=IN
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TRUSTED_PROXY_CIDRS=
GOOGLE_GEOCODING_API_KEY=
LOCATION_AUTOFILL_ENABLED=false

# Analytics and monitoring
GA4_MEASUREMENT_ID=
SENTRY_DSN=
LOG_LEVEL=warning

# Security and runtime
DISABLE_FILE_EDITOR=true
FORCE_SSL_ADMIN=false
COOKIE_SECURE=false
CHECKOUT_RATE_LIMIT_REQUESTS=3
CHECKOUT_RATE_LIMIT_SECONDS=60

# Local ports
WORDPRESS_PORT=8080
MAILPIT_UI_PORT=8025
